{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyInventory",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UploadToOneBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::my-learning-bucket/reports/*"
    },
    {
      "Sid": "StopOnlyDevInstances",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances"],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Env": "dev"}}
    }
  ]
}
